      "immutable": "4.3.9"
    },
    "eventsource": "1.1.1",
    "ansi-html": "0.0.8",
    "parse-url": "8.1.0",
    "remark-parse": {
      "trim": "0.0.3"
    },
    "flatted": "3.4.2",
    "serialize-javascript": "$serialize-javascript",
    "form-data": "4.0.6",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "braces": "3.0.3",
    "lodash": "4.18.1",
    "minimatch": "3.1.4",
    "shell-quote": "1.9.0",
    "body-parser": "1.20.3",
    "node-forge": "1.4.0",
