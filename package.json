    "parse-url": "8.1.0",
    "flatted": "3.4.2",
    "form-data": "4.0.6",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "braces": "3.0.3",
    "lodash": "4.18.1",
    "minimatch": "3.1.4",
    "shell-quote": "1.9.0",
    "body-parser": "1.20.3",
    "node-forge": "1.4.0",
    "tmp": "0.2.7",
    "cross-spawn": "7.0.5",
    "path-to-regexp": "0.1.13",
    "http-cache-semantics": "4.1.1",
    "picomatch": "2.3.2",
    "ip": "file:patches/ip",
    "js-yaml": "3.15.1"
  }
